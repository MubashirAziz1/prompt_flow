{
  "manifest_version": 3,
  "name": "Prompt Enhancer",
  "version": "0.1.0",
  "description": "Development foundation for the Prompt Enhancer Chrome extension.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://openrouter.ai/api/v1/*"
  ],
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Prompt Enhancer"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "content/floating-panel.js",
        "content/floating-geometry.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
